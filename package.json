{
    "name": "quickjs-lua",
    "version": "0.1.0",
    "description": "Lua bindings for QuickJS Native",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist/index.js",
        "dist/types",
        "postbuild.mjs"
    ],
    "scripts": {
        "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "rollup --config rollup.config.ts --configPlugin typescript && tsc --project tsconfig.json --declaration --emitDeclarationOnly --declarationDir dist/types",
        "postbuild": "node postbuild.mjs",
        "postinstall": "node postbuild.mjs",
        "prepack": "npm run build"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "unzipper": "^0.12.5"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.1",
        "quickjs-native": "git+https://github.com/michael79be/quickjs-native.git#main",
        "rollup": "^4.68.0",
        "typescript": "^6.0.3"
    }
}
